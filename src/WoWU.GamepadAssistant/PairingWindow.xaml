<Window x:Class="WoWU.GamepadAssistant.PairingWindow" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml" Title="Pair with WoWU" Width="410" SizeToContent="Height" ResizeMode="NoResize" WindowStyle="None" Icon="Assets/app.ico" Background="#0B0907" Foreground="#F1E8D3" WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
 <ContentControl Template="{StaticResource WoWFrameTemplate}" Padding="16,8,16,16"><StackPanel>
  <Grid Height="38" MouseLeftButtonDown="OnDrag"><TextBlock Text="Moonlight pairing" FontFamily="Georgia" Foreground="#E9C879" Margin="16,0,0,0" VerticalAlignment="Center"/><Button Style="{StaticResource WoWCloseButton}" HorizontalAlignment="Right" Click="OnCancel" ToolTip="Dismiss"/></Grid>
  <StackPanel Margin="25,12,25,25"><Image Source="Assets/icon.png" Width="58" Height="58" HorizontalAlignment="Center" Margin="0,0,0,14"/>
   <TextBlock x:Name="DeviceName" TextAlignment="Center" FontFamily="Georgia" FontSize="18" Foreground="#F3D583" Margin="0,0,0,8"/>
   <TextBlock Text="Enter the four-digit PIN shown in Moonlight." Foreground="#C3B599" TextAlignment="Center" Margin="0,0,0,18"/>
   <TextBox x:Name="Pin" MaxLength="4" Width="148" FontSize="28" TextAlignment="Center" HorizontalAlignment="Center" Padding="10" KeyDown="OnPinKeyDown"/>
   <TextBlock x:Name="Error" TextAlignment="Center" Foreground="#EEA16C" TextWrapping="Wrap" Margin="0,12,0,12"/>
   <Button x:Name="PairButton" Content="Pair device" Click="OnPair" HorizontalAlignment="Center" Margin="0"/>
  </StackPanel>
 </StackPanel></ContentControl>
</Window>
